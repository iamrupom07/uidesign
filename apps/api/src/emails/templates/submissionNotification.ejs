<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #1e293b;">
  <div style="border-bottom: 2px solid #e11d48; padding-bottom: 12px; margin-bottom: 20px;">
    <span style="font-family: monospace; font-size: 11px; color: #e11d48; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
      [NEW INCOMING INQUIRY DOSSIER]
    </span>
    <h2 style="margin: 6px 0 0 0; color: #0f172a; font-size: 20px; text-transform: uppercase;">
      <%= type %>: <%= subject || "New Project Submission" %>
    </h2>
  </div>

  <p style="font-size: 14px; line-height: 1.6; color: #334155;">
    A new <%= type.toLowerCase() %> inquiry has been submitted via the MacProtec platform.
  </p>

  <table style="width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 13px; background: #f8fafc; border: 1px solid #e2e8f0;">
    <tbody>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 10px 14px; font-weight: bold; width: 35%; color: #64748b; text-transform: uppercase; font-size: 11px;">Client Name</td>
        <td style="padding: 10px 14px; color: #0f172a; font-weight: 600;"><%= name %></td>
      </tr>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 10px 14px; font-weight: bold; color: #64748b; text-transform: uppercase; font-size: 11px;">Email Address</td>
        <td style="padding: 10px 14px; color: #0284c7;"><a href="mailto:<%= email %>" style="color: #0284c7; text-decoration: none;"><%= email %></a></td>
      </tr>
      <% if (phone) { %>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 10px 14px; font-weight: bold; color: #64748b; text-transform: uppercase; font-size: 11px;">Phone / Mobile</td>
        <td style="padding: 10px 14px; color: #0f172a;"><%= phone %></td>
      </tr>
      <% } %>
      <% if (company) { %>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 10px 14px; font-weight: bold; color: #64748b; text-transform: uppercase; font-size: 11px;">Company / Facility</td>
        <td style="padding: 10px 14px; color: #0f172a;"><%= company %></td>
      </tr>
      <% } %>
      <% if (sector) { %>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 10px 14px; font-weight: bold; color: #64748b; text-transform: uppercase; font-size: 11px;">Plant Sector</td>
        <td style="padding: 10px 14px; color: #0f172a;"><%= sector %></td>
      </tr>
      <% } %>
      <% if (budget) { %>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 10px 14px; font-weight: bold; color: #64748b; text-transform: uppercase; font-size: 11px;">Estimated Budget</td>
        <td style="padding: 10px 14px; color: #16a34a; font-weight: 600;"><%= budget %></td>
      </tr>
      <% } %>
      <% if (startDate) { %>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 10px 14px; font-weight: bold; color: #64748b; text-transform: uppercase; font-size: 11px;">Target Start Date</td>
        <td style="padding: 10px 14px; color: #0f172a;"><%= startDate %></td>
      </tr>
      <% } %>
      <% if (scope) { %>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 10px 14px; font-weight: bold; color: #64748b; text-transform: uppercase; font-size: 11px;">Scope / ROI Metrics</td>
        <td style="padding: 10px 14px; color: #0f172a; white-space: pre-line;"><%= scope %></td>
      </tr>
      <% } %>
    </tbody>
  </table>

  <div style="background: #ffffff; border: 1px solid #cbd5e1; border-left: 4px solid #e11d48; padding: 16px; margin: 20px 0;">
    <h4 style="margin: 0 0 8px 0; font-size: 12px; font-weight: bold; text-transform: uppercase; color: #475569;">
      Message / Challenge Details:
    </h4>
    <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #1e293b; white-space: pre-line;">
      <%= message %>
    </p>
  </div>

  <div style="margin-top: 24px; text-align: center;">
    <a href="<%= dashboardUrl || 'http://localhost:3000/dashboard/submissions' %>" style="display: inline-block; background: #0f172a; color: #ffffff; font-family: monospace; font-size: 12px; font-weight: bold; text-decoration: none; padding: 12px 24px; text-transform: uppercase; letter-spacing: 1px; border-radius: 0;">
      Open Submissions Dossier →
    </a>
  </div>
</div>
